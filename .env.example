# Port number
PORT=3000
# Environment
NODE_ENV=development
# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/room-manager
# JWT Secret
JWT_SECRET=your_jwt_secret_key_here
JWT_ACCESS_EXPIRATION_MINUTES=30

# AI & RAG Configuration
# Google Gemini API Key (Recommended)
GEMINI_API_KEY=
# OpenAI API Key (Optional alternative)
OPENAI_API_KEY=
# Provider: gemini | openai
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-1.5-flash
OPENAI_MODEL=gpt-4o-mini
# Embedding Provider: gemini | openai
EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=text-embedding-004
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
VECTOR_TOP_K=5
VECTOR_SIMILARITY_THRESHOLD=0.4


# MCP server (mounted at /mcp). Auth = user JWT from /api/v1/auth/login, or this optional static key
# (recommended for AI hosts since JWTs expire). Leave empty to allow JWT only.
MCP_API_KEY=
# Close idle MCP sessions after N minutes
MCP_SESSION_IDLE_MIN=30
